# ---------------------------------------------------------------------------
# Configuration du panneau d'administration. Copiez ce fichier en `.env` :
#   cp .env.example .env
# Aucun secret ne doit être committé : `.env` est ignoré par git.
# ---------------------------------------------------------------------------

# Port d'écoute.
PORT=3000

# Interface d'écoute. 127.0.0.1 = loopback uniquement (le plus sûr ; accès
# distant via le tunnel Cloudflare). 0.0.0.0 = accessible sur le réseau local.
# ⚠ Hors loopback, TLS est OBLIGATOIRE (voir TLS_* ci-dessous) sauf à mettre
# ALLOW_INSECURE_LAN=true (fortement déconseillé : identifiants en clair).
HOST=127.0.0.1

# TLS (HTTPS). Indispensable dès que HOST n'est pas 127.0.0.1, pour chiffrer les
# identifiants sur le réseau. Générez un certificat auto-signé : npm run gen-cert
# TLS_KEY=./certs/key.pem
# TLS_CERT=./certs/cert.pem

# Autorise l'écoute réseau en HTTP non chiffré (déconseillé). Laisser vide/false.
# ALLOW_INSECURE_LAN=false

# Secret de signature des cookies de session. Générez une valeur aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Identifiant de l'unique compte administrateur.
ADMIN_USER=admin

# Hash bcrypt (cost >= 12) du mot de passe. Générez-le SANS écrire le mot de
# passe en clair :  node scripts/hash-password.js 'votre mot de passe'
ADMIN_PASSWORD_HASH=

# Cookie `secure` (HTTPS uniquement). Laissez `true` en production derrière
# Cloudflare. Mettez `false` seulement pour un test local en HTTP pur.
COOKIE_SECURE=true

# Racine du gestionnaire de fichiers. '/' = accès complet au système (objet du
# panneau). Restreignez (ex. /srv ou /home) pour limiter la portée.
FILE_ROOT=/

# Taille max par fichier uploadé en octets (0 = illimité). Ex. 0 ou 1073741824.
MAX_UPLOAD_BYTES=0

# Shell lancé par le terminal web. Par défaut celui de l'utilisateur.
# SHELL=/bin/bash

# Chemin du journal d'audit (par défaut ./audit.log).
# AUDIT_LOG=/var/log/admin-panel/audit.log

# Durée de validité d'une session en millisecondes (défaut 8 h).
# SESSION_TTL_MS=28800000
